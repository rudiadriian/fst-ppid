# Salin ke `.env` untuk PENGEMBANGAN. `.env` tidak di-commit.
#
# Untuk PRODUKSI, berkas ini bukan tempatnya: nilai produksi hidup di
# `.env.production` yang ada di dalam repo dan dibaca otomatis oleh
# `vite build`. Hanya VITE_MAP_KEY yang datang dari CI/CD Variables.
#
# Semua VITE_* dibaca saat `npm run build`, bukan saat runtime. Mengubah nilainya
# setelah build tidak berpengaruh; panel harus di-build ulang.
#
# vite.config.mts menolak membangun bila VITE_API_BASE_URL atau
# VITE_RECAPTCHA_SITE_KEY kosong — lihat catatan di berkas itu.

# Alamat api-ppid. TANPA `/api` dan TANPA garis miring di akhir —
# `src/utils/api.ts` sendiri yang menambahkan `/api`, lalu rute memakai `v1/...`.
# Pengembangan: http://localhost:3000  (Vite mem-proxy /api/v1 ke 127.0.0.1:8001)
# Produksi:     https://api-ppid.foodstation.co.id
VITE_API_BASE_URL=http://localhost:3000

# Akar berkas media publik — folder storage milik fe-ppid.
# Produksi: https://ppid.foodstation.co.id/storage
VITE_MEDIA_BASE_URL=http://localhost:8000/storage

# Google Maps API key. Batasi dengan HTTP referrer
# `https://adm-ppid.foodstation.co.id/*` di Google Cloud Console.
VITE_MAP_KEY=

# Google reCAPTCHA v3 - site key (PUBLIK, memang tertanam di berkas build).
# Pasangannya, secret key, ada di api-ppid/.env sebagai PPID_RECAPTCHA_SECRET_KEY.
# Daftarkan domain panel di https://www.google.com/recaptcha/admin - token dari
# domain yang tidak terdaftar akan ditolak Google; untuk mencoba di mesin
# sendiri, daftarkan juga `localhost`.
# Nilai produksinya ada di .env.production.
VITE_RECAPTCHA_SITE_KEY=

# --- Firebase / AWS Cognito ---
# Kosongkan bila fitur ini tidak dipakai. Jangan isi dengan nilai contoh
# (`your-dev-app...`) — nilai palsu lebih membingungkan daripada kosong.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_AWS_PROJECT_REGION=
VITE_AWS_COGNITO_IDENTITY_POOL_ID=
VITE_AWS_COGNITO_REGION=
VITE_AWS_USER_POOLS_ID=
VITE_AWS_USER_POOLS_WEB_CLIENT_ID=
VITE_AWS_OAUTH_DOMAIN=
VITE_AWS_OAUTH_REDIRECT_SIGN_IN=
VITE_AWS_OAUTH_REDIRECT_SIGN_OUT=
